{
  "name": "notchbox",
  "productName": "NOTCHBOX",
  "version": "0.1.0",
  "description": "Barra inteligente no topo do ecrã",
  "main": "main.js",
  "author": "NOTCHBOX",
  "scripts": { "start": "electron .", "dist": "electron-builder" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.notchbox.app",
    "productName": "NOTCHBOX",
    "files": ["main.js", "preload.js", "index.html", "config.json", "build/icon.png"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "O NOTCHBOX usa o microfone para o assistente de voz.",
        "NSCameraUsageDescription": "O NOTCHBOX usa a câmara para o botão Mirror."
      }
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
